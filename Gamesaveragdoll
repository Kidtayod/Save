-- Marker
------------------------------------------------------------------
local function showMarker(pt: Vector3?)
    if not CFG.ShowMarker then
        if marker then marker:Destroy(); marker = nil end
        return
    end
    if not pt then
        if marker then marker:Destroy(); marker = nil end
        return
    end
    if not marker or not marker.Parent then
        local m = Instance.new("Part")
        m.Name = "GKTarget"
        m.Shape = Enum.PartType.Ball
        m.Size = Vector3.new(0.6, 0.6, 0.6)
        m.Anchored = true
        m.CanCollide = false; m.CanQuery = false; m.CanTouch = false
        m.Material = Enum.Material.Neon
        m.Color = Color3.fromRGB(0, 255, 120)
        m.Transparency = 0.5
        m.Parent = Workspace
        marker = m
    end
    marker.Position = pt
end

