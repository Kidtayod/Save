local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local UIS               = game:GetService("UserInputService")
local Workspace         = workspace
local RS                = game:GetService("ReplicatedStorage")

local LP = Players.LocalPlayer
if not LP then return end

local CFG = {
    -- WALK
    ActivateDistance = 40,
    WalkSpeed        = 16,
    Smoothness       = 0.08,
    DeadZone         = 2.0,
    IncomingConeDeg  = 100,
    PredictSeconds   = 3.0,
    GoalZonePad      = 12,

    -- DIVE (ล้มจริง)
    AutoDive         = true,
    DiveTriggerRange = 8.0,
    DiveMaxDistance  = 10.0,
    DiveFallDur      = 0.40,   -- เวลาล้ม
    DiveHoldDur      = 0.25,   -- เวลานอนติดพื้น
    DiveGetupDur     = 0.45,   -- เวลาลุก
    DiveDropHeight   = 2.5,    -- ตัวลงไปกี่ studs
    DiveTiltDeg      = 80,     -- เอียงกี่องศา (80 = เกือบนอน)
    DiveArcHeight    = 0.4,    -- arc ขึ้นนิดหน่อย
    DiveCooldown     = 1.3,
    MaxGKFromGoal    = 18,

    -- UI
    ShowStatus = true,
    ShowMarker = true,
    AssistOn   = true,
}

local char, root, isGK, myGoal
local assistOn = true
local assistVel = Vector3.new(0,0,0)
local lastDive = 0
local gui, statusLbl, toggleBtn, settingsBtn, settingsPanel
local marker: Part? = nil

local dive = {
    active = false,
    phase = "none",       -- "diving" | "hold" | "getup" | "none"
    t0 = 0,
    fallDur = 0,
    fallFrom = Vector3.new(),
    fallTo = Vector3.new(),
    fallBaseY = 0,
    baseRot = CFrame.new(),   -- ★ เก็บ rotation เริ่มต้น (ห้ามสะสม)
    tilt = 0,
    limbCollide = {},
}

local function now() return Workspace:GetServerTimeNow() end

local function getBall(): BasePart?
    for _, o in CollectionService:GetTagged("SoccerBall") do
        if o:IsA("BasePart") and o:IsDescendantOf(Workspace) then return o end
    end
    return nil
end

local function detectMyGoal()
    if not (root and char) then return end
    local s = RS:FindFirstChild("Shared")
    if s then s = s:FindFirstChild("Game") end
    if s then s = s:FindFirstChild("PitchBounds") end
    if not (s and s:IsA("ModuleScript")) then return end
    local ok, PB = pcall(require, s)
    if not ok or type(PB) ~= "table" or not PB.get then return end
    local ok2, bounds = pcall(PB.get)
    if not ok2 or not bounds or not bounds.goals then return end
    local myPos = root.Position
    local best, bestD = nil, math.huge
    for _, g in bounds.goals do
        if g.lo and g.hi then
            local cx = (g.lo.X+g.hi.X)*0.5
            local cy = (g.lo.Y+g.hi.Y)*0.5
            local cz = (g.lo.Z+g.hi.Z)*0.5
            local d = (Vector3.new(cx,cy,cz) - myPos).Magnitude
            if d < bestD then bestD = d; best = g end
        end
    end
    if not best then return end
    local lo, hi = best.lo, best.hi
    local center = Vector3.new((lo.X+hi.X)*0.5, (lo.Y+hi.Y)*0.5, (lo.Z+hi.Z)*0.5)
    local side = best.side or ((myPos.X > center.X) and 1 or -1)
    myGoal = { side=side, lo=lo, hi=hi, center=center, planeX=center.X }
end

local function gkNearGoal(): boolean
    if not (root and myGoal) then return false end
    return math.abs(root.Position.X - myGoal.planeX) <= CFG.MaxGKFromGoal
end

local function predictGoalCross(b: BasePart): Vector3?
    if not myGoal then return nil end
    local p, v = b.Position, b.AssemblyLinearVelocity
    local g = Workspace.Gravity
    local ga = b:GetAttribute("Gravity")
    if type(ga) == "number" and ga > 0 then g = ga end
    local planeX = myGoal.planeX
    local vx = v.X
    if math.abs(vx) < 0.5 then return nil end
    local dx = planeX - p.X
    if dx * vx <= 0 then return nil end
    local t = dx / vx
    if t <= 0 or t > CFG.PredictSeconds then return nil end
    local crossZ = p.Z + v.Z * t
    local crossY = p.Y + v.Y * t - 0.5 * g * t * t
    local lo, hi = myGoal.lo, myGoal.hi
    if crossZ < lo.Z - 3 or crossZ > hi.Z + 3 then return nil end
    if crossY < lo.Y - 2 or crossY > hi.Y + 3 then return nil end
    return Vector3.new(planeX, lo.Y + 0.5, crossZ)
end

local function incomingAngle(b: BasePart): number
    if not myGoal then return -1 end
    local v = b.AssemblyLinearVelocity
    local flatV = Vector3.new(v.X, 0, v.Z)
    if flatV.Magnitude < 2 then return -1 end
    local toGoal = myGoal.center - b.Position
    toGoal = Vector3.new(toGoal.X, 0, toGoal.Z)
    if toGoal.Magnitude < 0.1 then return 0 end
    return math.deg(math.acos(math.clamp(flatV.Unit:Dot(toGoal.Unit), -1, 1)))
end

------------------------------------------------------------------
-- Walk
------------------------------------------------------------------
local function walkToward(target: Vector3, dt: number)
    if not (char and root) then return end
    local cur = root.Position
    local delta = Vector3.new(target.X - cur.X, 0, target.Z - cur.Z)
    local dist = delta.Magnitude
    if dist < CFG.DeadZone then
        assistVel = assistVel:Lerp(Vector3.new(0,0,0), 0.3)
        if assistVel.Magnitude < 0.1 then assistVel = Vector3.new(0,0,0) end
    else
        local targetSpeed = math.min(dist * 1.5, CFG.WalkSpeed)
        if dist < 4 then targetSpeed = targetSpeed * (dist / 4) end
        local wantVel = delta.Unit * targetSpeed
        assistVel = assistVel:Lerp(wantVel, CFG.Smoothness)
    end
    if assistVel.Magnitude > CFG.WalkSpeed then
        assistVel = assistVel.Unit * CFG.WalkSpeed
    end
    if assistVel.Magnitude < 0.1 then
        assistVel = Vector3.new(0,0,0)
        return
    end
    local newPos = cur + assistVel * dt
    if myGoal then
        newPos = Vector3.new(
            math.clamp(newPos.X, myGoal.lo.X - CFG.GoalZonePad, myGoal.hi.X + CFG.GoalZonePad),
            newPos.Y,
            math.clamp(newPos.Z, myGoal.lo.Z - CFG.GoalZonePad, myGoal.hi.Z + CFG.GoalZonePad))
    end
    local cf = root.CFrame
    local newCF = CFrame.new(newPos) * (cf - cf.Position)
    pcall(function() char:PivotTo(newCF) end)
end

------------------------------------------------------------------
-- DIVE — ล้มลงจริง ไม่สะบัด
------------------------------------------------------------------
local function smoothstep(t: number): number
    t = math.clamp(t, 0, 1)
    return t * t * (3 - 2 * t)
end

local function startDive(targetZ: number)
    if not (char and root) then return end
    local from = root.Position
    local to = Vector3.new(from.X, from.Y, targetZ)
    local dist = math.abs(targetZ - from.Z)
    if dist < 0.3 then return end

    dive.active = true
    dive.phase = "diving"
    dive.t0 = now()
    dive.fallDur = math.clamp(0.30 + dist * 0.018, 0.30, 0.45)
    dive.fallFrom = from
    dive.fallTo = to
    dive.fallBaseY = from.Y
    dive.baseRot = root.CFrame - root.CFrame.Position   -- ★ เก็บ rotation เริ่มต้น
    dive.tilt = ((targetZ > from.Z) and 1 or -1) * math.rad(CFG.DiveTiltDeg)

    -- ปิด collision แขนชั่วคราว (กัน own goal)
    dive.limbCollide = {}
    for _, n in {"LeftHand","RightHand","LeftLowerArm","RightLowerArm","LeftArm","RightArm"} do
        local limb = char:FindFirstChild(n)
        if limb and limb:IsA("BasePart") then
            dive.limbCollide[limb] = limb.CanCollide
            limb.CanCollide = false
        end
    end
end

local function updateDive()
    if not dive.active then return end
    if not (char and root and root.Parent) then
        dive.active = false
        dive.phase = "none"
        -- คืน collision แขน
        for limb, c in dive.limbCollide do
            if limb and limb.Parent then limb.CanCollide = c end
        end
        dive.limbCollide = {}
        return
    end

    local t = now() - dive.t0

    -- ======= PHASE: diving (ล้ม) =======
    if dive.phase == "diving" then
        local p = math.clamp(t / dive.fallDur, 0, 1)
        local ease = smoothstep(p)

        -- tilt ramps เร็ว (ติดพื้นตอนจบ)
        local tiltAmt = math.min(p * 1.5, 1) * dive.tilt
        -- drop Y ramps เร็ว
        local dropAmt = math.min(p * 1.5, 1) * CFG.DiveDropHeight
        -- arc ขึ้นนิดหน่อยแล้วลง
        local arc = math.sin(p * math.pi) * CFG.DiveArcHeight

        local horizX = dive.fallFrom.X + (dive.fallTo.X - dive.fallFrom.X) * ease
        local horizZ = dive.fallFrom.Z + (dive.fallTo.Z - dive.fallFrom.Z) * ease

        local pos = Vector3.new(horizX, dive.fallBaseY - dropAmt + arc, horizZ)
        -- ★ ใช้ baseRot (ห้าม cf ปัจจุบัน = ไม่สะสม rotation)
        local newCF = CFrame.new(pos) * (dive.baseRot * CFrame.Angles(0, 0, tiltAmt))
        pcall(function() char:PivotTo(newCF) end)

        if p >= 1 then
            dive.phase = "hold"
            dive.t0 = now()
        end
        return
    end

    -- ======= PHASE: hold (นอนติดพื้น) =======
    if dive.phase == "hold" then
        -- คงท่าเดิม ไม่ขยับ
        if t >= CFG.DiveHoldDur then
            dive.phase = "getup"
            dive.t0 = now()
        end
        return
    end

    -- ======= PHASE: getup (ลุก) =======
    if dive.phase == "getup" then
        local p = math.clamp(t / CFG.DiveGetupDur, 0, 1)
        local ease = smoothstep(p)

        local tiltAmt = (1 - ease) * dive.tilt
        local dropAmt = (1 - ease) * CFG.DiveDropHeight

        local pos = Vector3.new(dive.fallTo.X, dive.fallBaseY - dropAmt, dive.fallTo.Z)
        local newCF = CFrame.new(pos) * (dive.baseRot * CFrame.Angles(0, 0, tiltAmt))
        pcall(function() char:PivotTo(newCF) end)

        if p >= 1 then
            -- คืน collision แขน
            for limb, c in dive.limbCollide do
                if limb and limb.Parent then limb.CanCollide = c end
            end
            dive.limbCollide = {}
            dive.phase = "none"
            dive.active = false
        end
        return
    end
end

local function tryDive(b: BasePart): boolean
    if not (char and root and myGoal) then return false end
    if not gkNearGoal() then return false end
    if now() - lastDive < CFG.DiveCooldown then return false end

    local ballSpeed = b.AssemblyLinearVelocity.Magnitude
    if ballSpeed < 8 then return false end

    local ang = incomingAngle(b)
    if ang < 0 or ang > CFG.IncomingConeDeg then return false end

    local gk = root.Position
    local hDist = Vector3.new(b.Position.X - gk.X, 0, b.Position.Z - gk.Z).Magnitude
    if hDist > CFG.DiveTriggerRange then return false end

    local cross = predictGoalCross(b)
    if not cross then return false end

    local lateralDist = math.abs(cross.Z - gk.Z)
    if lateralDist < 0.4 then return false end
    if lateralDist > CFG.DiveMaxDistance then return false end

    lastDive = now()
    startDive(cross.Z)
    return true
end

