    styleBtn(close, Color3.fromRGB(180,60,60), "CLOSE", 8)
    close.TextSize = 16; close.Parent = sp
    close.Activated:Connect(function() sp.Visible = false end)
end

------------------------------------------------------------------
-- Character
------------------------------------------------------------------
local function onChar(c: Model)
    char = c
    root = c:WaitForChild("Root", 10) :: BasePart?
    if not root then root = c:WaitForChild("HumanoidRootPart", 5) :: BasePart? end
    isGK = c:GetAttribute("Role") == "Goalkeeper"
    task.wait(0.3); detectMyGoal()
end

local function onCharRemoving()
    char = nil; root = nil; isGK = false; myGoal = nil
    assistVel = Vector3.new(0,0,0)
    dive.active = false
    dive.phase = "none"
    dive.limbCollide = {}
    showMarker(nil)
end

LP.CharacterAdded:Connect(onChar)
LP.CharacterRemoving:Connect(onCharRemoving)
if LP.Character then onChar(LP.Character) end

buildGui()

task.spawn(function()
    while true do
        task.wait(1)
        if char and char.Parent then
            isGK = char:GetAttribute("Role") == "Goalkeeper"
            if not myGoal then detectMyGoal() end
        end
    end
end)

------------------------------------------------------------------
-- Main loop
------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not (char and char.Parent and root and root.Parent) then
        showMarker(nil); return
    end

    -- Dive animation (รวม phase hold + getup)
    if dive.active then
        updateDive()
        if statusLbl and CFG.ShowStatus then
            statusLbl.Text = "DIVE: " .. dive.phase
        end
        return
    end

    if not isGK then
        if statusLbl and CFG.ShowStatus then statusLbl.Text = "not GK" end
        showMarker(nil); return
    end
    if not myGoal then
        if statusLbl and CFG.ShowStatus then statusLbl.Text = "no goal" end
        showMarker(nil); return
    end
    if not gkNearGoal() then
        if statusLbl and CFG.ShowStatus then statusLbl.Text = "too far from goal" end
        showMarker(nil)
        assistVel = assistVel * 0.5
        return
    end
